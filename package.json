{
    "author": "Classify Learning",
    "name": "@classifylearning/frontend-messenger",
    "description": "Project to utilize AWS AppSync to send live updates to the frontend.",
    "repository": "git@github.com:classifylearning/frontend-messenger.git",
    "main": "src/Messenger.ts",
    "types": "build/Messenger.d.ts",
    "license": "MIT",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/"
    },
    "scripts": {
        "build:dev": "cross-env NODE_ENV=development webpack --progress",
        "build:prod": "cross-env NODE_ENV=production BUILD_DIR=./dist/ webpack --progress",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src/ --ext .ts,.tsx",
        "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "typecheck": "tsc --noEmit",
        "update": "npm-check-updates -u",
        "watch": "cross-env NODE_ENV=development webpack --progress --watch"
    },
    "version": "2.1.0",
    "files": [
        "build/",
        "dist/"
    ],
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "clean-webpack-plugin": "^4.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "filemanager-webpack-plugin": "^9.0.1",
        "jest": "^30.2.0",
        "npm-check-updates": "^19.3.2",
        "prettier": "^3.8.1",
        "terser-webpack-plugin": "^5.3.16",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.5.4",
        "typescript": "^5.9.3",
        "webpack": "^5.104.1",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "aws-amplify": "^6.16.0"
    },
    "overrides": {
        "fast-xml-parser": "^5.7.1"
    }
}
